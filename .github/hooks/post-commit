#!/bin/bash

# 跨平台兼容的 info 文件夹同步脚本

# 设置错误处理
set -e

# 获取当前分支
CURRENT_BRANCH=$(git branch --show-current)

# 只在主要分支同步
case "$CURRENT_BRANCH" in
    main|master|develop)
        # 继续执行
        ;;
    *)
        echo "跳过 info 同步：当前分支 '$CURRENT_BRANCH' 不是主要分支"
        exit 0
        ;;
esac

# 检查 info 文件夹
if [ ! -d "info" ]; then
    echo "info 文件夹不存在，跳过同步"
    exit 0
fi

# 检查是否有 info 相关更改
if git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -q "^info/" || 
   git diff --name-only HEAD HEAD 2>/dev/null | grep -q "^info/"; then
    echo "检测到 info/ 文件夹变化，正在同步到 info 分支..."
    
    # 切换到 info 分支
    if git show-ref --verify --quiet refs/heads/info; then
        git checkout info
    else
        echo "创建 info 分支..."
        git checkout --orphan info
        # 清理新分支
        git rm -rf . 2>/dev/null || true
    fi
    
    # 从原分支复制 info 文件夹
    git checkout "$CURRENT_BRANCH" -- info/
    
    # 提交更改
    git add info/
    if ! git diff --staged --quiet; then
        git commit -m "自动同步: 更新 info 文件夹内容 [来自 $CURRENT_BRANCH 分支]"
        echo "✅ info 文件夹已同步到 info 分支"
    else
        echo "ℹ️  info 文件夹没有实际变化需要同步"
    fi
    
    # 返回原分支
    git checkout "$CURRENT_BRANCH"
else
    echo "info 文件夹无变化，跳过同步"
fi